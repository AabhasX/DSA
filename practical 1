#include <stdio.h>
#define MAX 100

int tree[MAX];
int size = 0;

void insert(int value) {
    if (size < MAX) {
        tree[size++] = value;
    }
}

void delete(int value) {
    int i;
    for (i = 0; i < size; i++) {
        if (tree[i] == value) break;
    }
    if (i < size) {
        tree[i] = tree[size - 1];
        size--;
    }
}

void display() {
    for (int i = 0; i < size; i++) {
        printf("%d ", tree[i]);
    }
    printf("\n");
}

int main() {
    int choice, value;

    while (1) {
        printf("1.Insert\n2.Delete\n3.Display\n4.Exit\n");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                scanf("%d", &value);
                insert(value);
                break;
            case 2:
                scanf("%d", &value);
                delete(value);
                break;
            case 3:
                display();
                break;
            case 4:
                return 0;
        }
    }
}
